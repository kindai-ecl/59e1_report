%% Tectonic-compatible junsrt style for this report.
%% Entries are emitted in citation order. Bibliographic punctuation is
%% generated by BibTeX; author display strings remain controlled by the
%% UTF-8 .bib database.

ENTRY
  { author
    title
    journal
    booktitle
    howpublished
    volume
    number
    pages
    year
    note
  }
  {}
  {}

INTEGERS
  { output.state
    before.all
    mid.sentence
    after.sentence
    after.block
    nameptr
    namesleft
    numnames
  }
STRINGS { s t }

FUNCTION {init.state.consts}
{ #0 'before.all :=
  #1 'mid.sentence :=
  #2 'after.sentence :=
  #3 'after.block :=
}

FUNCTION {output.nonnull}
{ 's :=
  output.state mid.sentence =
    { ", " * write$ }
    { output.state after.block =
        { add.period$ write$
          newline$
          "\newblock " write$
        }
        { output.state before.all =
            'write$
            { add.period$ " " * write$ }
          if$
        }
      if$
      mid.sentence 'output.state :=
    }
  if$
  s
}

FUNCTION {output}
{ duplicate$ empty$
    'pop$
    'output.nonnull
  if$
}

FUNCTION {output.check}
{ 't :=
  duplicate$ empty$
    { pop$ "empty " t * " in " * cite$ * warning$ }
    'output.nonnull
  if$
}

FUNCTION {new.block}
{ output.state before.all =
    'skip$
    { after.block 'output.state := }
  if$
}

FUNCTION {new.sentence}
{ output.state after.block =
    'skip$
    { output.state before.all =
        'skip$
        { after.sentence 'output.state := }
      if$
    }
  if$
}

FUNCTION {fin.entry}
{ add.period$
  write$
  newline$
}

FUNCTION {output.bibitem}
{ newline$
  "\bibitem{" write$
  cite$ write$
  "}" write$
  newline$
  ""
  before.all 'output.state :=
}

FUNCTION {format.volume.number}
{ volume empty$
    { "" }
    { "Vol.~" volume * }
  if$
  number empty$
    'skip$
    { duplicate$ empty$
        { pop$ "No.~" number * }
        { ", No.~" * number * }
      if$
    }
  if$
}

FUNCTION {format.pages}
{ pages empty$
    { "" }
    { "pp.~" pages * }
  if$
}

FUNCTION {format.names}
{ 's :=
  #1 'nameptr :=
  s num.names$ 'numnames :=
  numnames 'namesleft :=
  { namesleft #0 > }
  { s nameptr "{f.~}{vv~}{ll}{, jj}" format.name$ 't :=
    nameptr #1 >
      { namesleft #1 >
          { ", " * t * }
          { numnames #2 >
              { "," * }
              'skip$
            if$
            " and " * t *
          }
        if$
      }
      't
    if$
    nameptr #1 + 'nameptr :=
    namesleft #1 - 'namesleft :=
  }
  while$
}

FUNCTION {article}
{ output.bibitem
  author format.names "author" output.check
  new.block
  title "title" output.check
  new.block
  journal "journal" output.check
  format.volume.number output
  format.pages output
  year "year" output.check
  new.block
  note output
  fin.entry
}

FUNCTION {inproceedings}
{ output.bibitem
  author format.names "author" output.check
  new.block
  title "title" output.check
  new.block
  "In " booktitle * "booktitle" output.check
  format.pages output
  year "year" output.check
  new.block
  note output
  fin.entry
}

FUNCTION {misc}
{ output.bibitem
  author format.names "author" output.check
  new.block
  title "title" output.check
  new.block
  howpublished output
  year output
  note output
  fin.entry
}

FUNCTION {default.type} { misc }

FUNCTION {begin.bib}
{ "\begin{thebibliography}{99}" write$
  newline$
  newline$
}

FUNCTION {end.bib}
{ newline$
  "\end{thebibliography}" write$
  newline$
}

READ

EXECUTE {init.state.consts}
EXECUTE {begin.bib}

ITERATE {call.type$}

EXECUTE {end.bib}
